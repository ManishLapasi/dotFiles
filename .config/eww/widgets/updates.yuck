(defpoll update_no :interval "600s" `bash ~/.config/eww/scripts/pacman_updates.sh`)

(defwidget updates []
    (box :class "module" :space-evenly "false" :orientation "h" :spacing "3" 
        (label :text "󰮯 " :class "updates")
        (label :text update_no :class "updates" )
        (label :text "updates" :class "updates")))
