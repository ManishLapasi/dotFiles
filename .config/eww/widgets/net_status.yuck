(defpoll net_status :interval "20s" `bash ~/.config/eww/scripts/network.sh`)

(defwidget net_status []
    (box :class "module" :hexpand false :vexpand false :space-evenly "true" :orientation "h"
      (button :onclick "bash ~/.config/eww/scripts/popup.sh wifi"
        (label :text net_status :class "net_status" ))))
