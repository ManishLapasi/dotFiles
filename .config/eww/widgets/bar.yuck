(include "widgets/date.yuck")
(include "widgets/time.yuck")
(include "widgets/workspaces.yuck")
(include "widgets/net_status.yuck")
(include "widgets/updates.yuck")
(include "widgets/cpu_usage.yuck")
(include "widgets/ram_usage.yuck")
(include "widgets/battery_percent.yuck")
(include "widgets/powermenu.yuck")

(defwidget bar []
    (centerbox :orientation "h" :class "bar"
        (box :class "left" :halign "start" :hexpand false :vexpand false
            (updates))
        (box :class "center" :halign "center" :hexpand false :vexpand false
            (workspaces))
        (box :class "right" :halign "end" :hexpand false :vexpand false :spacing "1"
            (cpu_usage)
            (ram_usage)
            (battery_percent)
            (net_status)
            (time))))
