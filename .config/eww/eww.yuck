(include "widgets/bar.yuck")
(include "widgets/whichkey.yuck")

(defwindow bar
	   :monitor 0
	   :geometry (geometry :x "0px"
        	               :y "2px"
                	       :width "100%"
                           :height "20px"
	                       :anchor "top center")
	   :stacking "fg"
       :exclusive true 
    (bar))

(defwindow whichkey 
	   :monitor 0
       :vexpand true
	   :geometry (geometry :x "0px"
        	               :y "10px"
                	       :width "100%"
                           :height "50px"
	                       :anchor "bottom center")
	   :stacking "fg"
       :exclusive false 
    (whichkey))
           
